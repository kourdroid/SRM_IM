# ONEE SRM Mobile App - Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.

# 1. Supabase Project Credentials
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Optional integrations
EXPO_PUBLIC_N8N_WEBHOOK_URL=https://n8n.example.com/webhook/your-webhook-id

# 3. Optional production monitoring
EXPO_PUBLIC_SENTRY_DSN=https://9942eab63183086ae93f8f803ca2e8fb@o4510821382946816.ingest.de.sentry.io/4511705538494544
# Required by EAS Build for Sentry source map uploads. Store the real value as an EAS secret.
SENTRY_AUTH_TOKEN=

# Android push configuration. Use an EAS file variable for cloud builds.
# GOOGLE_SERVICES_JSON=/absolute/path/to/google-services.json
